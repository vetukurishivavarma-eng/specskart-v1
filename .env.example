# ---- Database (prod profile / docker-compose) ----
DB_URL=jdbc:postgresql://postgres:5432/specskart
DB_USERNAME=specskart
DB_PASSWORD=specskart

# ---- Redis (reserved for Phase 2 short-lived session cache) ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- App ----
FRONTEND_BASE_URL=http://localhost:8081
SESSION_SECRET=change-me-a-long-random-secret-at-least-32-bytes-long!!
SPECSKART_STORE_NAME=Specskart
SPECSKART_BUSINESS_WA_NUMBER=+260000000000
SPECSKART_ADMIN_EMAIL=admin@specskart.local
SPECSKART_ADMIN_PASSWORD=admin12345
SPECSKART_SIMULATION_ENABLED=true
FACE_RETAIN_IMAGES=false
FRAME_FINDER_SESSION_EXPIRY_HOURS=72

# ---- WhatsApp Business Cloud API ----
# provider = mock (default, no credentials) | meta (real Graph API)
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v21.0

# ---- Frontend build arg ----
VITE_WA_LINK=https://wa.me/260000000000
